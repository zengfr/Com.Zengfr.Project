<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		<appender name="consoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%date|%5p|%4t|%-24c|%m%n"  />
			</layout>
		</appender>
		<appender name="filleAppender" type="log4net.Appender.FileAppender">
			<param name="File" value="F:log-file.txt" />
			<layout type="log4net.Layout.PatternLayout">
				<param name="ConversionPattern" value="%date|%5p|%4t|%-24c|%m%n"  />
			</layout>
		</appender>
		<root>
			<level value="INFO"/>
			<appender-ref ref="consoleAppender" />
		</root>
	</log4net>
</configuration>