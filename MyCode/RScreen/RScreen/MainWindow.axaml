<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScrcpyNet.Sample.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scrcpy="using:ScrcpyNet.Avalonia"
		xmlns:c="clr-namespace:ScrcpyNet.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ScrcpyNet.Sample.Avalonia.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RScreen by scrcpy4net" WindowState="Maximized"  WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<c:StringCutConverter x:Key="stringCutConverter" />
	</Window.Resources>
	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid ColumnDefinitions="220,2,*">
		<Grid Grid.Column="0">
			<StackPanel  Margin="1" Spacing="1">
				<Grid ColumnDefinitions="20*,80*" RowDefinitions="Auto,Auto,Auto"  Margin="0">
					<TextBlock Text="Size:" Grid.Row="0" Grid.Column="0"/>
					<TextBlock Text="Bitrate:" Grid.Row="1" Grid.Column="0"/>
					<TextBlock Text="Fps:" Grid.Row="2" Grid.Column="0"/>
					<NumericUpDown Grid.Row="0" Grid.Column="1" Increment="1" Minimum="1" Maximum="6" Value="{Binding ScreenCfg.DisplySize}"/>
					<NumericUpDown Grid.Row="1" Grid.Column="1" Increment="500" Minimum="500" Maximum="8000"  Value="{Binding ScreenCfg.BitrateKb}"/>
					<NumericUpDown Grid.Row="2" Grid.Column="1" Increment="5" Minimum="5" Maximum="50"  Value="{Binding ScreenCfg.MaxFps}"/>
				</Grid>
				<DockPanel MinWidth="200">
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding RebootDevicesCommand}">
						<Svg  Width="22" Height="22" Name="restart" Path="/Assets/restart-svgrepo-com.svg" />
					</Button>
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding WakeUpDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_arrow_upward" Path="/Assets/ic_arrow_upward.svg" />
					</Button>
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding MenuDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_menu" Path="/Assets/ic_menu.svg" />
					</Button>
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding AppDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_apps" Path="/Assets/ic_apps.svg" />
					</Button>
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding HomeDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_home" Path="/Assets/ic_home.svg" />
					</Button>
					<Button  DockPanel.Dock="Right" Margin="0,0" Padding="2,2" Command="{Binding BackDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_arrow_back" Path="/Assets/ic_arrow_back.svg" />
					</Button>
					<Button DockPanel.Dock="Left"  Margin="0,0" Padding="2,2" Command="{Binding RefreshDevicesCommand}">
						<Svg  Width="22" Height="22" Name="ic_refresh" Path="/Assets/ic_refresh.svg" />
					</Button>
				</DockPanel>

				<ListBox Height="740" Margin="0,0" BorderThickness="0,0" ScrollViewer.VerticalScrollBarVisibility="Visible" ItemsSource="{Binding AvailableDevices}" HorizontalAlignment="Stretch" >
					<ListBox.Styles>
						<Style Selector="ListBoxItem">
							<Setter Property="Margin" Value="0,0,1,0"/>
							<Setter Property="Padding" Value="0,0"/>
						</Style>
					</ListBox.Styles>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid  Margin="0,0" >
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="44*"/>
									<ColumnDefinition Width="22*"/>
									<ColumnDefinition Width="34*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Column="0" Text="{Binding Serial, Converter={StaticResource stringCutConverter}}"/>
								<TextBlock Grid.Column="1" Text="{Binding State}"/>
								<TextBlock Grid.Column="2" Text="{Binding Model}"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</Grid>
		<GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>
		<Grid Grid.Column="2">
			<scrcpy:ScrcpyDisplay3 DeviceViews="{Binding DeviceViews}"/>
		</Grid>
	</Grid>

</Window>
