#set($outputConfig.OutputDir = "base\\")
#set($outputConfig.OutputFileName = "pom.xml")

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>com.github.zengfr.project.basepom</artifactId>
	<packaging>pom</packaging>
	<properties>
	  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	  <jdk.version>1.8</jdk.version>
	  <projectversion>0.0.2</projectversion>
	</properties>
	<version>0.0.2</version>
	<parent>
		<groupId>com.github.zengfr.project</groupId>
		<artifactId>com.github.zengfr.project.pom</artifactId>
		<version>0.0.2</version>
	</parent>
	<build>
	    <defaultGoal>compile</defaultGoal>
		<sourceDirectory>src/main</sourceDirectory> 
		<resources>
		    <resource>
              <directory>src/main/java</directory>
	        </resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>*.xml</include>
					<include>*.properties</include>
					<include>*.config</include>
					<include>*.txt</include>
					<include>*.cfg</include>
					<include>*.MF</include>
					<include>*.vm</include>
					<include>*.jstl</include>
					<include>*/*.*</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${jdk.version}</source>
					<target>${jdk.version}</target>
					<compilerArgument>-proc:none</compilerArgument>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
		</dependency>
	</dependencies>
	<modules>
		<module>entity</module>
		<module>daobase</module>
		<module>businessbase</module>
		<module>restservicebase</module>
		<module>controllerbase</module>
		<module>clientbase</module>
		<module>jobbase</module>
		<module>mqbase</module>
	</modules>
	<dependencyManagement>
	<dependencies>
	      <dependency>
				<groupId>joda-time</groupId>
				<artifactId>joda-time</artifactId>
				<version>2.9.9</version>
			</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>com.github.zengfr.project.common</artifactId>
			<version>${projectversion}</version>
		</dependency>	
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>entity</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>daobase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>businessbase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>restservicebase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>clientbase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>controllerbase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>mqbase</artifactId>
			<version>${projectversion}</version>
		</dependency>
		<dependency>
			<groupId>com.github.zengfr.project</groupId>
			<artifactId>jobbase</artifactId>
			<version>${projectversion}</version>
		</dependency>
	</dependencies>
	</dependencyManagement>
</project>