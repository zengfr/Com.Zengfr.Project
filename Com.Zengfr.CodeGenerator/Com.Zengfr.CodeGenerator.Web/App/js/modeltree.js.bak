Ext.define('app.view.main.Model', {
    extend: 'Ext.tree.Panel',
    alias: 'widget.model',
    initComponent: function () {
        var me = this;
        var cmenu = Ext.create('widget.modelMenu');
        me.contextMenu = cmenu;
        Ext.apply(me, {
            title: 'Model',
            tbar: [{
                text: 'Expand',
                handler: function () {
                    me.expandAll();
                }
            }, '-', {
                text: 'Collapse',
                handler: function () {
                    me.collapseAll();
                    me.getRootNode().expand();
                }
            }, '-', {
                text: 'Import',
                handler: function () {
                    me.collapseAll();
                    me.getRootNode().expand();
                }
            }, '-'],
            useArrows: true, animate: true,
            store: Ext.create('ModelTreeStore'),
            listeners: {
                click: function (node) {
                    Ext.Msg.alert('消息', '你点击了: "' + node + "'");
                },
                checkchange: function (node, checked) {
                    // node.
                    node.expand();
                    node.set('checked', checked);
                    node.eachChild(function (child) {
                        child.set('checked', checked);
                        child.fireEvent('checkchange', child, checked);
                    });
                },
                render: function () {
                    Ext.getBody().on("contextmenu", Ext.emptyFn, null, { preventDefault: true });
                },
                itemcontextmenu: function (tree, record, item, index, e, eOpts) {
                    e.preventDefault();
                    if (record.isLeaf()) {
                        cmenu.items.items.forEach(function (element, index, array) {
                            if (element.getItemId().indexOf('add') == -1) {
                                element.setVisible(true);
                            }
                            else {
                                element.setVisible(false);
                            }
                        });
                    }
                    else {
                        cmenu.items.items.forEach(function (element, index, array) {
                            if (element.getItemId().indexOf('add') != -1) {
                                element.setVisible(true);
                            }
                            else {
                                element.setVisible(false);
                            }
                        });
                    }
                    cmenu.showAt(e.getXY()); cmenu.tag = record;
                    e.stopEvent();
                }
            }
        }
        );
        me.callParent(arguments);
    },

});
Ext.define('app.view.main.Left', {
    extend: 'Ext.Panel',
    alias: 'widget.left',

    initComponent: function () {
        var me = this;
        Ext.apply(me, {
            region: 'west',
            title: 'west',
            width: 250,
            layout: 'accordion',
            collapsible: true, xtype: 'container',
            layoutConfig: {
                animate: true
            },
            split: true, containerScroll: true,
            items: [
                    Ext.create('app.view.main.Model'),
                    Ext.create('app.view.main.Template')
            ]

        });
        me.callParent(arguments);
    }
});
Ext.define('app.view.main.Left2', {
    extend: 'Ext.Panel',
    alias: 'widget.left2',

    initComponent: function () {
        var me = this;
        Ext.apply(me, {
            region: 'west', id: 'left',
            //title: 'west',
            width: 260,
            layout: 'accordion',
            collapsible: true, xtype: 'container',
            layoutConfig: {
                animate: true, hideCollapseTool: true
            },
            split: true, containerScroll: true, //scrollable: true,
            items: [
                    Ext.create('app.view.main.Model'),
                    Ext.create('app.view.main.Template')
            ]

        });
        me.callParent(arguments);
    },
    showOne: function (name) {
        var me = this;
        me.items.items.forEach(function (element, index, array) {

            if (element.id.indexOf(name) != -1) {
                element.show();
                element.expand();
            }
            else {
                element.collapse();
                element.hide();
            }
        });//
    }
});






Ext.define("app.model.Model", {
    extend: "Ext.data.Model",
    fields: [
        { name: 'id', type: 'int', mapping: 'Id' },
        { name: 'text', type: 'string', mapping: 'Name' },
        { name: 'fullName', type: 'string', mapping: 'FullName' },
        {
            name: 'leaf', type: 'boolean', convert: function (v, r) {
                return r.get("IsFile");
            }
        },
        {
            name: 'checked', type: 'boolean', defaultValue: false
        }
    ],
    idProperty: 'fullName',
    api: {
        create: 'api/Model/createModel',
        read: 'api/Model/readModel',
        update: 'api/Model/updateModel',
        destroy: 'api/Model/destroyModel'
    }
});

Ext.define('app.view.ModelForm', {
    extend: 'Ext.form.Panel',
    alias: 'widget.modelForm',
    layout: 'form',
    bodyPadding: 5, height: 240,
    defaultType: 'textfield',
    //title:'Model',
    items: [{
        xtype: "hidden",
        name: 'id',
     
    }, {
        fieldLabel: 'Namespaces',
        name: 'fullName',
        allowBlank: false
    }, {
        fieldLabel: 'ModelName',
        name: 'text',
        allowBlank: false
    }
    ],
    initComponent: function () {
        var me = this;
        Ext.apply(me, {
            buttons: [
            {
                xtype: "button", text: "Save",
                handler: function () {
                    var record = me.getRecord();
                    var form = me.getForm();
                    form.updateRecord(record);
                }
            },
             {
                 id: "btnReset",
                 iconCls: 'a_cross',  //样式
                 text: 'reset',
                 handler: function () {
                     var form = me.getForm();
                     form.reset();
                 }
             }
            ]
        });
        me.callParent(arguments);
    }
    
    
});

Ext.define("app.store.ModelTreeStore", {
    extend: "Ext.data.TreeStore",
    alias: 'ModelTreeStore',
    model: "app.model.Model",
    nodeParam: 'path',
    proxy: {
        type: 'ajax',
        reader: { type: 'json' },
        writer: { type: 'json' },
        api: {
            create: 'api/Model/createModel',
            read: 'api/Model/readModel',
            update: 'api/Model/updateModel',
            destroy: 'api/Model/destroyModel'
        }
    },
    sorters: [{
        property: 'name',
        direction: 'ASC'
    }],
    root: {
        text: 'Model',fullName:'.',
        id: '0', checked: null
    }
});

