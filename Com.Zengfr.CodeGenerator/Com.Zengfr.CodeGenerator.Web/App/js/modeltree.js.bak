Ext.define('app.view.model.menu', {
    extend: 'Ext.menu.Menu',
    alias: 'widget.modelMenu',
    width: 100,
    margin: '0 0 10 0',
    items: [{
        text: 'Edit', id: 'editModel', handler: function (widget, event) {
            // addTab('q77', '777', 'widget.modelForm', {});
            var record = widget.parentMenu.tag;
            var editForm = Ext.create("app.view.ModelForm", {  });
            editForm.loadRecord(record);
            var editwin = Ext.create('widget.modelWindow', { items: editForm });
            editwin.show();
        }
    }, {
        text: 'Edit Attrs', id: 'editModelAttrs', handler: function (widget, event) {
            addTab('q7', '7', 'widget.modelGrid', {});
        }
    }, {
        text: 'Add By DB', id: 'addModelByDB',
        handler: function (widget, event) {
            addTab('q88', '88', 'widget.modelForm', {});
        }
    }, {
        text: 'Add By File', id: 'addModelByFile', handler: function (widget, event) {
            addTab('q888', '888', 'widget.modelForm', {});
        }
    }, '-', {
        text: 'Add', id: 'addModel', handler: function (widget, event) {
            showLog('123');
            addTab('q55', '555', '');
        }
    }, {
        text: 'Delete', id: 'deleteModel', handler: function (widget, event) {
            addTab('q66', '666', '');
        }
    }]
});

Ext.define('app.view.ModelGrid', {
    extend: 'Ext.grid.Panel',
    alias: 'widget.modelGrid',
    requires: [
        'Ext.grid.plugin.RowEditing',
        'Ext.grid.*',
        'Ext.data.*',
    'Ext.util.*',
    'Ext.state.*',
    'Ext.form.*'
    ],

    initComponent: function () {
        var me = this;
        var rowEditing = Ext.create('Ext.grid.plugin.RowEditing', {
            autoCancel: false, clicksToEdit: 1
        });
        var store = Ext.create('ModelTreeStore');

        

        Ext.apply(me, {
            store: store,
            viewConfig: {
                stripeRows: true,
                enableTextSelection: true
            },
             selModel: {
                  injectCheckbox: 0,
                  mode: "SIMPLE",     //"SINGLE"/"SIMPLE"/"MULTI"
                  checkOnly: true     //只能通过checkbox选择
              },
            selType: "checkboxmodel",
            loadMask: true,
            columns: [{
                header: 'id',
                dataIndex: 'id',
                flex: 1,
                editor: {
                    allowBlank: false
                }
            }],
            //width: 700,
            height: 200,
            frame: true, scrollable: true,
            tbar: [{
                text: 'Add',
                iconCls: '',
                handler: function () {
                    rowEditing.cancelEdit();
                    var r = Ext.create('app.model.Model', {
                        name: 'New Guy',
                        email: 'new@sencha-test.com',
                        start: Ext.Date.clearTime(new Date()),
                        salary: 50000,
                        active: true
                    });

                    store.insert(0, r);
                    rowEditing.startEdit(0, 0);
                }
            },'-', {
                itemId: 'delete',
                text: 'Delete',
                iconCls: '',
                handler: function () {
                    var sm = grid.getSelectionModel();
                    rowEditing.cancelEdit();
                    store.remove(sm.getSelection());
                    if (store.getCount() > 0) {
                        sm.select(0);
                    }
                },
                disabled: true
            }, '-'],
            dockedItems: [{
                xtype: 'pagingtoolbar',
                store: store,   // same store GridPanel is using
                dock: 'bottom',
                displayInfo: true
            }],
            plugins: [rowEditing],
            listeners: {
                selectionchange: function (view, records) {
                    me.down('#delete').setDisabled(!records.length);
                }
            }
        });

        me.callParent(arguments);
    }
});